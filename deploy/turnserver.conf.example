# Render SERVER_PUBLIC_IPV4 and GENERATED_SECRET on the host, outside the repo.
listening-ip=SERVER_PUBLIC_IPV4
relay-ip=SERVER_PUBLIC_IPV4
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49259
realm=meshrooms.wormdb.dev
server-name=meshrooms.wormdb.dev
use-auth-secret
static-auth-secret=GENERATED_SECRET
cert=/etc/meshrooms/turn/fullchain.pem
pkey=/etc/meshrooms/turn/privkey.pem
no-tlsv1
no-tlsv1_1
no-dtls
no-cli
no-tcp-relay
no-multicast-peers
no-software-attribute
stale-nonce=600
max-allocate-lifetime=3600
# Relay capacity. Every allocation holds one UDP relay port from min-port..max-port
# (no-tcp-relay), and that range has 49259 - 49160 + 1 = 100 ports, which is also what
# the firewall opens. total-quota must not exceed the port count, or coturn admits
# allocations it has no port for. 96 leaves a small margin for ports that are briefly
# unavailable. user-quota applies per TURN username: 96 / 16 = 6 usernames at full quota.
# To grow, widen min-port/max-port and the firewall rule together, then raise total-quota
# to at most the new port count.
user-quota=16
total-quota=96
max-bps=131072
bps-capacity=8388608
relay-threads=2
log-file=stdout
simple-log
# Never let a room use the relay to reach private or special networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
# Loopback peers are denied by Coturn's default policy. Do not add the
# unspecified address :: here: Coturn 4.6 treats it as a wildcard for IPv4 too.
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
