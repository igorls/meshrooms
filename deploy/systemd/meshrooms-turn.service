[Unit]
Description=Meshrooms authenticated browser relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
ExecStart=/usr/bin/turnserver -c /etc/meshrooms/turnserver.conf --pidfile=/run/meshrooms-turn/turn.pid
Restart=on-failure
RestartSec=3
RuntimeDirectory=meshrooms-turn
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=100%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
