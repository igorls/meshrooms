[Unit]
Description=Meshrooms private Tailnet admin
After=network-online.target tailscaled.service meshrooms-browser.service
Wants=network-online.target

[Service]
Type=simple
User=meshrooms
Group=meshrooms
WorkingDirectory=/opt/meshrooms/current
EnvironmentFile=/etc/meshrooms/admin.env
ExecStart=/opt/meshrooms/bin/bun run server/browser/admin-main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/meshrooms-browser
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=128M
CPUQuota=50%
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
