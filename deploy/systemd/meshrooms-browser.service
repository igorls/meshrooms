[Unit]
Description=Meshrooms browser room coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshrooms
Group=meshrooms
WorkingDirectory=/opt/meshrooms/current
EnvironmentFile=/etc/meshrooms/browser.env
EnvironmentFile=/opt/meshrooms/current/release.env
ExecStart=/opt/meshrooms/bin/bun run server/browser/main.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=meshrooms-browser
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=100%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
